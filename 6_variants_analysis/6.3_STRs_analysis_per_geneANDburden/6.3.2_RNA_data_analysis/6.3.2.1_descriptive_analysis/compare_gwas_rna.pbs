#!/bin/bash
#PBS -q workq
#PBS -N compare_gwas_rna
#PBS -o compare_gwas_rna.out
#PBS -e compare_gwas_rna.err
#PBS -V

REPO="/storage2/matheusbomfim/projects/git_repos/STRs_COVID_Analysis"
MAMBA="/storage2/matheusbomfim/projects/micromamba"
TOP="$REPO/6_variants_analysis/6.3_STRs_analysis_per_geneANDburden"
WORKDIR="$TOP/6.3.2_RNA_data_analysis/6.3.2.1_descriptive_analysis"

export MAMBA_ROOT_PREFIX="$MAMBA"
eval "$(/storage2/matheusbomfim/projects/micromamba/bin/micromamba shell hook --shell bash)"
micromamba activate r_enrich_env

R_BIN="$(command -v Rscript)"
[ -x "$R_BIN" ] || { echo "ERRO: Rscript ausente no env r_enrich_env"; exit 1; }

cd "$WORKDIR" || { echo "ERRO: WORKDIR $WORKDIR ausente"; exit 1; }

"$R_BIN" compare_gwas_rna.R \
  --rna-outliers "$TOP/6.3.2_RNA_data_analysis/6.3.2.2_RNA_matrix/results/intervention_strs.tsv" \
  --catalog "$REPO/samples/STRs_analysis_dataset.tsv" \
  --out-dir "$WORKDIR/results" \
  || { echo "ERRO na analise descritiva RNA-seq"; exit 1; }

echo "=== FIM: resultados em results/ (6.3.2.1_descriptive_analysis) ==="