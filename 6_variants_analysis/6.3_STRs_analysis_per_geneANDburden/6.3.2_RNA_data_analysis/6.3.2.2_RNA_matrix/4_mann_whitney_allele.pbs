#!/bin/bash
#PBS -q workq
#PBS -N mann_whitney_intervention
#PBS -o 4_mann_whitney_allele.out
#PBS -e 4_mann_whitney_allele.err
#PBS -V
#PBS -l nodes=1:ppn=1
#PBS -l walltime=01:00:00

# Etapa 4: Mann-Whitney U test case vs control por intervencao.
# Pre-requisito: 1_cross_intervention_STRs.pbs (gera intervention_outliers.tsv em results/).
REPO="/storage2/matheusbomfim/projects/git_repos/STRs_COVID_Analysis"
MAMBA="/storage2/matheusbomfim/projects/micromamba"
WORKDIR="$REPO/6_variants_analysis/6.3_STRs_analysis_per_geneANDburden/6.3.2_RNA_data_analysis/6.3.2.2_RNA_matrix"

export MAMBA_ROOT_PREFIX="$MAMBA"
eval "$(/storage2/matheusbomfim/projects/micromamba/bin/micromamba shell hook --shell bash)"
micromamba activate r_enrich_env

R_BIN="$(command -v Rscript)"
[ -x "$R_BIN" ] || { echo "ERRO: Rscript ausente no env r_enrich_env"; exit 1; }

cd "$WORKDIR" || { echo "ERRO: WORKDIR $WORKDIR ausente"; exit 1; }
mkdir -p results

# Inputs
INTV_DIR="$WORKDIR/results"
OUTLIERS="$INTV_DIR/intervention_outliers.tsv"

[ -f "$OUTLIERS" ] || { echo "ERRO: $OUTLIERS ausente ( rode 1_cross_intervention_STRs.pbs primeiro )"; exit 1; }

echo "=== Mann-Whitney U test por intervencao ==="

# Rodar para cada GSE e para ALL
for GSE in GSE157103 GSE183533 GSE188847 ALL; do
  echo "--- Processing $GSE ---"
  "$R_BIN" 4_mann_whitney_allele.R \
    --str-catalog "$OUTLIERS" \
    --intervention "$GSE" \
    --out-dir results
done

echo "=== FIM ==="
