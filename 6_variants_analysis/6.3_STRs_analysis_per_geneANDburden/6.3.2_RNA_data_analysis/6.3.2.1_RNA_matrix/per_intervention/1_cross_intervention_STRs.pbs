#!/bin/bash
#PBS -q workq
#PBS -N cross_intervention
#PBS -o 1_cross_intervention_STRs.out
#PBS -e 1_cross_intervention_STRs.err
#PBS -V
#PBS -l nodes=1:ppn=1
#PBS -l walltime=01:00:00

# Etapa 1: Cruzação DEGs por intervenção com STRs da coorte.
# Pre-requisito: TSVs de DEGs nas subpastas GSE (GSE157103/, GSE183533/, GSE188847/).
REPO="/storage2/matheusbomfim/projects/git_repos/STRs_COVID_Analysis"
MAMBA="/storage2/matheusbomfim/projects/micromamba"
WORKDIR="$REPO/6_variants_analysis/6.3_STRs_analysis_per_geneANDburden/6.3.2_RNA_data_analysis/6.3.2.1_RNA_matrix/per_intervention"

export MAMBA_ROOT_PREFIX="$MAMBA"
eval "$(/storage2/matheusbomfim/projects/micromamba/bin/micromamba shell hook --shell bash)"
micromamba activate str

cd "$WORKDIR" || { echo "ERRO: WORKDIR $WORKDIR ausente"; exit 1; }
mkdir -p results

STR_CATALOG="$REPO/samples/STRs_analysis_dataset.tsv"
[ -f "$STR_CATALOG" ] || { echo "ERRO: catalogo $STR_CATALOG ausente"; exit 1; }

echo "=== Cruzamento DEGs x STRs por intervenção ==="
python3 1_cross_intervention_STRs.py \
    --deg-dir ../.. \
    --str-catalog "$STR_CATALOG" \
    --out-dir results
echo "=== FIM ==="
