#!/bin/bash
#PBS -q workq
#PBS -N rna_radar
#PBS -o 4_radar_genomic_location.out
#PBS -e 4_radar_genomic_location.err
#PBS -V
#PBS -l nodes=1:ppn=1
#PBS -l walltime=01:00:00

# Etapa 4: Radar plots: localizacao genômica de outliers e sem sobreposicao.
# Pre-requisito: 1_cross_DEGs_STRs.pbs (gera rna_outlier_genes.tsv,
#                rna_summary_by_study.tsv em results/)
REPO="/storage2/matheusbomfim/projects/git_repos/STRs_COVID_Analysis"
MAMBA="/storage2/matheusbomfim/projects/micromamba"
WORKDIR="$REPO/6_variants_analysis/6.3_STRs_analysis_per_geneANDburden/6.3.2_RNA_data_analysis/6.3.2.1_RNA_matrix/per_study"

export MAMBA_ROOT_PREFIX="$MAMBA"
eval "$(/storage2/matheusbomfim/projects/micromamba/bin/micromamba shell hook --shell bash)"
micromamba activate r_enrich_env

R_BIN="$(command -v Rscript)"
[ -x "$R_BIN" ] || { echo "ERRO: Rscript ausente no env r_enrich_env"; exit 1; }

cd "$WORKDIR" || { echo "ERRO: WORKDIR $WORKDIR ausente"; exit 1; }
mkdir -p results

# Inputs (resultados do passo 1)
RNA_DIR="$WORKDIR/results"

[ -f "$RNA_DIR/rna_outlier_genes.tsv" ] || { echo "ERRO: $RNA_DIR/rna_outlier_genes.tsv ausente"; exit 1; }
[ -f "$RNA_DIR/rna_summary_by_study.tsv" ] || { echo "ERRO: $RNA_DIR/rna_summary_by_study.tsv ausente"; exit 1; }

echo "=== Instalando pacotes R ausentes ==="
"$R_BIN" -e 'pkgs <- c("data.table","dplyr","ggplot2","patchwork","scales"); new <- pkgs[!sapply(pkgs, requireNamespace, quietly=TRUE)]; if(length(new)) install.packages(new, repos="https://cloud.r-project.org")'

echo "=== Radar plots: localizacao genômica ==="
"$R_BIN" 4_radar_genomic_location.R \
  --rna-outliers "$RNA_DIR/rna_outlier_genes.tsv" \
  --summary "$RNA_DIR/rna_summary_by_study.tsv" \
  --out-dir results
echo "=== FIM ==="
