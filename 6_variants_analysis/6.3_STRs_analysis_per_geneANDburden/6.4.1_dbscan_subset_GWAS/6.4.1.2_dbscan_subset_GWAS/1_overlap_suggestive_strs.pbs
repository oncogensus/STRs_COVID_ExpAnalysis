#!/bin/bash
#PBS -q workq
#PBS -N STR6412_overlap
#PBS -o 1_overlap_suggestive_strs.out
#PBS -e 1_overlap_suggestive_strs.err
#PBS -V
#PBS -l nodes=1:ppn=1
#PBS -l walltime=02:00:00

# Etapa 1/4 de 6.4.1.2: cruza genes COVID sugestivos x STRs da coorte.
# Entrada: results/covid_genes_suggestive.tsv (gerado em 6.4.1.1) + catalogo de STR.
# Saida:   results/suggestive_gene_strs.tsv, data/suggestive_strs_ids.txt
REPO="/storage2/matheusbomfim/projects/git_repos/STRs_COVID_Analysis"
MAMBA="/storage2/matheusbomfim/projects/micromamba"
WORKDIR="$REPO/6_variants_analysis/6.3_STRs_analysis_per_geneANDburden/6.4.1_dbscan_subset_GWAS/6.4.1.2_dbscan_subset_GWAS"

export MAMBA_ROOT_PREFIX="$MAMBA"
eval "$(/storage2/matheusbomfim/projects/micromamba/bin/micromamba shell hook --shell bash)"
micromamba activate igv

PYBIN="$(command -v python3)"
[ -x "$PYBIN" ] || { echo "ERRO: python3 ausente no env igv"; exit 1; }

cd "$WORKDIR" || { echo "ERRO: WORKDIR $WORKDIR ausente"; exit 1; }
mkdir -p data results

CATALOG="${CATALOG:-$REPO/samples/STRs_analysis_dataset.tsv}"
[ -f "$CATALOG" ] || { echo "ERRO: catalogo $CATALOG ausente"; exit 1; }

# Gera covid_genes_suggestive.tsv (p<1e-5) se ausente, reusando extract_covid_genes.py
# de 6.4.1.1 (pre-requisito: 6.4.1.1 ja rodou download + build_gene_bed).
EXTRACT="../6.4.1.1_covid19hg_overlap/3_extract_covid_genes.py"
GTF_DIR="../6.4.1.1_covid19hg_overlap/data"
GENE_BED="../6.4.1.1_covid19hg_overlap/genes.hg38.bed"
if [ ! -f results/covid_genes_suggestive.tsv ]; then
  if [ -f "$GENE_BED" ] && [ -f "$GTF_DIR/COVID19_HGI_A2_ALL_leave_23andme_20220403.tsv.gz" ]; then
    echo "Gerando results/covid_genes_suggestive.tsv (p<1e-5) a partir de 6.4.1.1..."
    "$PYBIN" "$EXTRACT" \
      --sumstats \
        "$GTF_DIR/COVID19_HGI_A2_ALL_leave_23andme_20220403.tsv.gz" \
        "$GTF_DIR/COVID19_HGI_B2_ALL_leave_23andme_20220403.tsv.gz" \
        "$GTF_DIR/COVID19_HGI_C2_ALL_leave_23andme_20220403.tsv.gz" \
      --gene-bed "$GENE_BED" \
      --out results/covid_genes_suggestive.tsv \
      --p-thresh 1e-5
  else
    echo "ERRO: results/covid_genes_suggestive.tsv ausente e 6.4.1.1 nao preparado."
    echo "      Rode 6.4.1.1 (download + build_gene_bed + extract) antes."
    exit 1
  fi
fi
[ -f results/covid_genes_suggestive.tsv ] || { echo "ERRO: falha ao gerar covid_genes_suggestive.tsv"; exit 1; }

echo "=== 1/4 overlap genes sugestivos x STRs da coorte ==="
"$PYBIN" 1_overlap_suggestive_strs.py \
  --catalog "$CATALOG" \
  --covid-genes results/covid_genes_suggestive.tsv \
  --out results/STRs_analysis_dataset_with_GWAS.tsv \
  --out-overlap results/suggestive_gene_strs.tsv \
  --ids-out data/suggestive_strs_ids.txt
echo "=== FIM ==="
