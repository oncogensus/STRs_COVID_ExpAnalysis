#!/bin/bash
#PBS -q workq
#PBS -N STR6412_summarize
#PBS -o 3_summarize_subset.out
#PBS -e 3_summarize_subset.err
#PBS -V
#PBS -l nodes=1:ppn=1
#PBS -l walltime=01:00:00

# Etapa 3/4 de 6.4.1.2: junta dataset unificado com outliers DBSCAN (filtra n_outliers>0) + resumo.
# Entrada: results/STRs_analysis_dataset_with_GWAS.tsv (etapa 1),
#          results/suggestive_strs_outliers.tsv (etapa 2).
# Saida:   results/covid_suggestive_genes_with_outlier_STRs.tsv,
#          results/summary_overlap_dbscan.tsv
REPO="/storage2/matheusbomfim/projects/git_repos/STRs_COVID_Analysis"
MAMBA="/storage2/matheusbomfim/projects/micromamba"
WORKDIR="$REPO/6_variants_analysis/6.3_STRs_analysis_per_geneANDburden/6.4.1_dbscan_subset_GWAS/6.4.1.2_dbscan_subset_GWAS"

export MAMBA_ROOT_PREFIX="$MAMBA"
eval "$(/storage2/matheusbomfim/projects/micromamba/bin/micromamba shell hook --shell bash)"
micromamba activate igv

PYBIN="$(command -v python3)"
[ -x "$PYBIN" ] || { echo "ERRO: python3 ausente no env igv"; exit 1; }

cd "$WORKDIR" || { echo "ERRO: WORKDIR $WORKDIR ausente"; exit 1; }
mkdir -p results

[ -f results/STRs_analysis_dataset_with_GWAS.tsv ] || { echo "ERRO: results/STRs_analysis_dataset_with_GWAS.tsv ausente (rode etapa 1)"; exit 1; }
[ -f results/suggestive_strs_outliers.tsv ] || { echo "ERRO: results/suggestive_strs_outliers.tsv ausente (rode etapa 2)"; exit 1; }
[ -f results/covid_genes_significant.tsv ] || { echo "ERRO: results/covid_genes_significant.tsv ausente (rode etapa 1)"; exit 1; }

echo "=== 4/4 sumariza subset + resumo comparativo ==="
"$PYBIN" 3_summarize_subset.py \
  --unified results/STRs_analysis_dataset_with_GWAS.tsv \
  --dbscan results/suggestive_strs_outliers.tsv \
  --covid-genes-sig results/covid_genes_significant.tsv \
  --out results/covid_suggestive_genes_with_outlier_STRs.tsv \
  --summary results/summary_overlap_dbscan.tsv
echo "=== FIM ==="
