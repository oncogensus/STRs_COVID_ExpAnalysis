#!/bin/bash
#PBS -q workq
#PBS -N rna_mann_whitney
#PBS -o mann_whitney_allele.out
#PBS -e mann_whitney_allele.err
#PBS -V
#PBS -l nodes=1:ppn=1
#PBS -l walltime=01:00:00

# Teste de Mann-Whitney: allele2_est case vs control para STRs de DEGs.
# Pre-requisito: 6.1_merge_datasets.r (gera STRs_analysis_dataset.tsv com group)
#                cross_DEGs_STRs.py (gera rna_gene_strs.tsv)
REPO="/storage2/matheusbomfim/projects/git_repos/STRs_COVID_Analysis"
MAMBA="/storage2/matheusbomfim/projects/micromamba"
WORKDIR="$REPO/6_variants_analysis/6.3_STRs_analysis_per_geneANDburden/6.4.2_dbscan_subset_RNA/6.4.2.3_rna_visualization/per_study"

export MAMBA_ROOT_PREFIX="$MAMBA"
eval "$(/storage2/matheusbomfim/projects/micromamba/bin/micromamba shell hook --shell bash)"
micromamba activate r_enrich_env

R_BIN="$(command -v Rscript)"
[ -x "$R_BIN" ] || { echo "ERRO: Rscript ausente no env r_enrich_env"; exit 1; }

cd "$WORKDIR" || { echo "ERRO: WORKDIR $WORKDIR ausente"; exit 1; }
mkdir -p results

# Inputs
RNA_DIR="$REPO/6_variants_analysis/6.3_STRs_analysis_per_geneANDburden/6.4.2_dbscan_subset_RNA/6.4.2.2_RNA_matrix/per_study/results"
STR_CATALOG="$REPO/samples/STRs_analysis_dataset.tsv"

[ -f "$STR_CATALOG" ] || { echo "ERRO: catalogo $STR_CATALOG ausente"; exit 1; }
[ -f "$RNA_DIR/rna_gene_strs.tsv" ] || { echo "ERRO: $RNA_DIR/rna_gene_strs.tsv ausente"; exit 1; }

echo "=== Instalando pacotes R ausentes ==="
"$R_BIN" -e 'pkgs <- c("data.table","dplyr","ggplot2","ggpubr","rstatix","scales","patchwork"); new <- pkgs[!sapply(pkgs, requireNamespace, quietly=TRUE)]; if(length(new)) install.packages(new, repos="https://cloud.r-project.org")'

echo "=== Mann-Whitney U test: mean_allele + allele2_est case vs control ==="
"$R_BIN" mann_whitney_allele.R \
  --str-catalog "$STR_CATALOG" \
  --rna-gene-strs "$RNA_DIR/rna_gene_strs.tsv" \
  --out-dir results
echo "=== FIM ==="
