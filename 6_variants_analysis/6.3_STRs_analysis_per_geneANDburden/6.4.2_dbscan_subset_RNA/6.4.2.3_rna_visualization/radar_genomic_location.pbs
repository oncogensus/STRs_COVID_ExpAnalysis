#!/bin/bash
#PBS -q workq
#PBS -N rna_radar
#PBS -o radar_genomic_location.out
#PBS -e radar_genomic_location.err
#PBS -V
#PBS -l nodes=1:ppn=1
#PBS -l walltime=01:00:00

# Radar plots: localizacao genômica de outliers e sem sobreposicao.
# Pre-requisito: cross_DEGs_STRs.py (gera rna_outlier_genes.tsv,
#                rna_summary_by_study.tsv em results/)
#                6.1_merge_datasets.r (gera STRs_analysis_dataset.tsv)
REPO="/storage2/matheusbomfim/projects/git_repos/STRs_COVID_Analysis"
MAMBA="/storage2/matheusbomfim/projects/micromamba"
WORKDIR="$REPO/6_variants_analysis/6.3_STRs_analysis_per_geneANDburden/6.4.2_dbscan_subset_RNA/6.4.2.3_rna_visualization"

export MAMBA_ROOT_PREFIX="$MAMBA"
eval "$(/storage2/matheusbomfim/projects/micromamba/bin/micromamba shell hook --shell bash)"
micromamba activate str

cd "$WORKDIR" || { echo "ERRO: WORKDIR $WORKDIR ausente"; exit 1; }
mkdir -p results

# Instalar fmsb se ausente
Rscript -e 'if (!requireNamespace("fmsb", quietly=TRUE)) install.packages("fmsb", repos="https://cloud.r-project.org")'

# Inputs
RNA_DIR="$REPO/6_variants_analysis/6.3_STRs_analysis_per_geneANDburden/6.4.2_dbscan_subset_RNA/6.4.2.2_RNA_matrix/results"

[ -f "$RNA_DIR/rna_outlier_genes.tsv" ] || { echo "ERRO: $RNA_DIR/rna_outlier_genes.tsv ausente"; exit 1; }
[ -f "$RNA_DIR/rna_summary_by_study.tsv" ] || { echo "ERRO: $RNA_DIR/rna_summary_by_study.tsv ausente"; exit 1; }

echo "=== Radar plots: localizacao genômica ==="
Rscript radar_genomic_location.R \
  --rna-outliers "$RNA_DIR/rna_outlier_genes.tsv" \
  --summary "$RNA_DIR/rna_summary_by_study.tsv" \
  --out-dir results
echo "=== FIM ==="
