#!/bin/bash
#PBS -q workq
#PBS -N STR6412_dbscan
#PBS -o 2_run_dbscan_subset.out
#PBS -e 2_run_dbscan_subset.err
#PBS -V
#PBS -l nodes=1:ppn=2
#PBS -l walltime=12:00:00

# Etapa 2/4 de 6.4.1.2: subset dos residuos normalizados + re-roda DBSCAN.
# Entrada: data/suggestive_strs_ids.txt (etapa 1),
#          residuos normalizados de 5_global_dbscan (RESIDUALS).
# Saida:   results/suggestive_strs_outliers.tsv
REPO="/storage2/matheusbomfim/projects/git_repos/STRs_COVID_Analysis"
MAMBA="/storage2/matheusbomfim/projects/micromamba"
WORKDIR="$REPO/6_variants_analysis/6.4_STRs_analysis_per_geneANDburden/6.4.1_per_str_analysis/6.4.1.2_dbscan_subset"

export MAMBA_ROOT_PREFIX="$MAMBA"
eval "$(/storage2/matheusbomfim/projects/micromamba/bin/micromamba shell hook --shell bash)"
micromamba activate dbscan-r

R_BIN="$(command -v Rscript)"
[ -x "$R_BIN" ] || { echo "ERRO: Rscript ausente no env dbscan-r"; exit 1; }

cd "$WORKDIR" || { echo "ERRO: WORKDIR $WORKDIR ausente"; exit 1; }
mkdir -p data results

ROOT="$REPO"
# 5_dbscan foi renomeado para 5_global_dbscan na reorganizacao
RESIDUALS="${RESIDUALS:-$ROOT/5_global_dbscan/norm_test/STRs_normalized_residuals.tsv}"
[ -f "$RESIDUALS" ] || { echo "ERRO: residuos $RESIDUALS ausentes (rode 5_global_dbscan)"; exit 1; }
[ -f data/suggestive_strs_ids.txt ] || { echo "ERRO: data/suggestive_strs_ids.txt ausente (rode etapa 1)"; exit 1; }
[ -f results/suggestive_gene_strs.tsv ] || { echo "ERRO: results/suggestive_gene_strs.tsv ausente (rode etapa 1)"; exit 1; }

echo "=== 2/4 subset de residuos (awk) + DBSCAN (R) ==="
awk -F'\t' '
NR==FNR { ids[$1]; next }
FNR==1  { for(i=1;i<=NF;i++) if($i=="STRs_ID") c=i; print; next }
$(c) in ids
' data/suggestive_strs_ids.txt "$RESIDUALS" > data/suggestive_strs_residuals.tsv

"$R_BIN" 2_run_dbscan_subset.R data/suggestive_strs_residuals.tsv results/suggestive_strs_outliers.tsv

echo "=== 2b/4 (anotacao do catalogo movida para 5_annotate_catalog.pbs) ==="
micromamba activate igv
echo "=== FIM ==="
