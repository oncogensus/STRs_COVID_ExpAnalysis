#!/bin/bash
#PBS -q workq
#PBS -N STR6414_pathways
#PBS -o 1_pathway_crossvalidation.out
#PBS -e 1_pathway_crossvalidation.err
#PBS -V

REPO="/storage2/matheusbomfim/projects/git_repos/STRs_COVID_Analysis"
MAMBA="/storage2/matheusbomfim/projects/micromamba"
WORKDIR="$REPO/6_variants_analysis/6.4_STRs_analysis_per_geneANDburden/6.4.1_per_str_analysis/6.4.1.4_pathway_crossvalidation"

export MAMBA_ROOT_PREFIX="$MAMBA"
eval "$(/storage2/matheusbomfim/projects/micromamba/bin/micromamba shell hook --shell bash)"
micromamba activate r_enrich_env

R_BIN="$(command -v Rscript)"
[ -x "$R_BIN" ] || { echo "ERRO: Rscript ausente no env r_enrich_env"; exit 1; }

cd "$WORKDIR" || { echo "ERRO: WORKDIR $WORKDIR ausente"; exit 1; }
mkdir -p results

# Corrigir results/results/ duplicado (se existir)
GWAS_DIR="../6.4.1.2_dbscan_subset_GWAS"
if [ -d "$GWAS_DIR/results/results" ]; then
  echo "Corrigindo results/results/ duplicado..."
  mv "$GWAS_DIR/results/results/"* "$GWAS_DIR/results/" 2>/dev/null
  rmdir "$GWAS_DIR/results/results" 2>/dev/null
fi
if [ -d "$GWAS_DIR/data/data" ]; then
  echo "Corrigindo data/data/ duplicado..."
  mv "$GWAS_DIR/data/data/"* "$GWAS_DIR/data/" 2>/dev/null
  rmdir "$GWAS_DIR/data/data" 2>/dev/null
fi

echo "=== 1/3 enrichment de vias (KEGG + Reactome) ==="
"$R_BIN" 1_pathway_crossvalidation.R
echo "=== FIM ==="
