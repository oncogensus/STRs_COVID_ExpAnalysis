#!/bin/bash
#PBS -q workq
#PBS -N pathway_crossvalidation
#PBS -o pathway_crossvalidation.pbs.out
#PBS -e pathway_crossvalidation.pbs.err
#PBS -V
#PBS -l nodes=1:ppn=1
#PBS -l walltime=04:00:00

cd $PBS_O_WORKDIR

export MAMBA_ROOT_PREFIX="/storage2/matheusbomfim/projects/micromamba"
MICROMAMBA="$MAMBA_ROOT_PREFIX/bin/micromamba"

# Garante pacotes do env r_enrich_env (no-op se ja existirem)
"$MICROMAMBA" install -n r_enrich_env -c conda-forge -y r-reactomepa r-msigdbr r-upsetr r-patchwork 2>&1 | tail -3 || \
  echo "AVISO: nao foi possivel instalar via micromamba; se os pacotes ja existirem no env r_enrich_env, pode ignorar."

RSCRIPT="$MAMBA_ROOT_PREFIX/envs/r_enrich_env/bin/Rscript"

echo "=== Pathway cross-validation (KEGG + Reactome) ==="
"$RSCRIPT" pathway_crossvalidation.R
echo "=== pronto ==="
