#!/bin/bash
#PBS -q workq
#PBS -N covid19hg_build_bed
#PBS -o build_gene_bed.pbs.out
#PBS -e build_gene_bed.pbs.err
#PBS -V
#PBS -l nodes=1:ppn=1
#PBS -l walltime=01:00:00

cd $PBS_O_WORKDIR

export MAMBA_ROOT_PREFIX="/storage2/matheusbomfim/projects/micromamba"
eval "$(/storage2/matheusbomfim/projects/micromamba/bin/micromamba shell hook --shell bash)"
micromamba activate igv

echo "=== GTF -> genes.hg38.bed ==="
python build_gene_bed.py \
  --gtf data/gencode.v39.primary_assembly.annotation.gtf.gz \
  --out genes.hg38.bed
echo "=== pronto ==="
