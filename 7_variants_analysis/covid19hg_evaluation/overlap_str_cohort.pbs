#!/bin/bash
#PBS -q workq
#PBS -N covid19hg_overlap
#PBS -o overlap_str_cohort.pbs.out
#PBS -e overlap_str_cohort.pbs.err
#PBS -V
#PBS -l nodes=1:ppn=1
#PBS -l walltime=02:00:00

cd $PBS_O_WORKDIR

export MAMBA_ROOT_PREFIX="/storage2/matheusbomfim/projects/micromamba"
eval "$(/storage2/matheusbomfim/projects/micromamba/bin/micromamba shell hook --shell bash)"
micromamba activate igv

# >>> AJUSTE se o catalogo de STR da coorte estiver em outro caminho <<<
CATALOG="/storage2/matheusbomfim/projects/git_repos/STRs_COVID_Analysis/samples/STRs_analysis_dataset.tsv"

echo "=== cruza genes COVID x STRs da coorte ==="
python overlap_str_cohort.py \
  --catalog "$CATALOG" \
  --covid-genes covid_genes.tsv \
  --out covid_genes_with_cohort_STRs.tsv \
  --window 50000
echo "=== pronto ==="
