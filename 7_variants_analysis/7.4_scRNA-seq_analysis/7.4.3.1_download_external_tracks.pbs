#!/bin/bash
#PBS -q workq
#PBS -N download_external_tracks
#PBS -j oe
#PBS -V

cd $PBS_O_WORKDIR

# Micromamba environment setup
export MAMBA_ROOT_PREFIX="/storage2/matheusbomfim/projects/micromamba"
eval "$(/storage2/matheusbomfim/projects/micromamba/bin/micromamba shell hook --shell bash)"
micromamba activate str

# Execute the download script
bash 7_variants_analysis/7.4_scRNA-seq_analysis/7.4.3.1_download_external_tracks.sh

# Clean up PBS default output file (script writes its own timestamped log)
rm -f "${PBS_O_WORKDIR}/download_external_tracks.o${PBS_JOBID}" 2>/dev/null || true